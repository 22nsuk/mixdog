# Normalize line endings: LF in repo, auto on checkout
* text=auto
.gitattributes text eol=lf

# Always LF for shell scripts
*.sh text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
# Uploaded to the Linux VPS and rendered there by bash.
apps/relay/deploy/coturn/* text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Published benchmark artifacts are evidence: keep every byte exactly as the
# harness wrote it, with no end-of-line normalization on checkout or commit.
# Covers every run folder records/<harness>/<model>/<date>/, including new harnesses.
benchmarks/terminal-bench-2.1/records/*/*/*/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol conflict-marker-size=1024

# Binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.node binary
